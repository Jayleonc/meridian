# Meridian local environment

# Backend dev script behavior.
# false keeps uvicorn startup/error logs but hides noisy HTTP access logs such as /health polling.
MERIDIAN_UVICORN_ACCESS_LOG=false

# Model provider boundary. Console talks to Nexus /api/chat; Nexus talks to the model.
MERIDIAN_MODEL_PROVIDER=openai
MERIDIAN_MODEL_NAME=gpt-4.1

# Use either OPENAI_API_KEY for OpenAI, or MERIDIAN_MODEL_API_KEY for compatible gateways.
OPENAI_API_KEY=
MERIDIAN_MODEL_API_KEY=
MERIDIAN_MODEL_BASE_URL=

# Agent Chat persistence. If PostgreSQL is unavailable, Nexus falls back to in-memory sessions.
MERIDIAN_CHAT_DB_ENABLED=true
MERIDIAN_DB_HOST=127.0.0.1
MERIDIAN_DB_PORT=15432
MERIDIAN_DB_USER=root
MERIDIAN_DB_PASSWORD=jayleonc
MERIDIAN_DB_NAME=meridian

# Nexus downstream timeout in seconds.
NEXUS_SERVICE_TIMEOUT=30

# Direct-clone dev server binding. Nexus is the only externally reachable port.
MERIDIAN_NEXUS_HOST=0.0.0.0
MERIDIAN_INTERNAL_HOST=127.0.0.1
MERIDIAN_DEVOPS_ENABLED=true
MERIDIAN_SERVICE_LOG_DIR=
MERIDIAN_RUN_DIR=
MERIDIAN_REPO_ROOT=

# Optional override. By default Nexus serves ../console/dist relative to nexus/src/server.py.
CONSOLE_DIST_DIR=
